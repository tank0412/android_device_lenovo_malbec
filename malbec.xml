<?xml version="1.0" encoding="UTF-8"?>
<!--
     Local manifest for malbec (Lenovo TB390FU) on crDroid 13 (Android 17).

     device, kernel and vendor are all confirmed to have `crDroid-17.0`.
     MindTheGapps branch mapping:
         baklava     = Android 16 (LineageOS 23.x)   NOT for crDroid 13
         cinnamonbun = Android 17 (LineageOS 24)     correct for crDroid 13
-->
<manifest>
    <remote name="tank0412" fetch="https://github.com/tank0412" />

    <project path="device/lenovo/malbec"
             name="android_device_lenovo_malbec"
             remote="tank0412"
             revision="crDroid-17.0" />

    <project path="device/lenovo/malbec-kernel"
             name="android_device_lenovo_malbec-kernel"
             remote="tank0412"
             revision="crDroid-17.0" />

    <project path="vendor/lenovo/malbec"
             name="proprietary_vendor_lenovo_malbec"
             remote="tank0412"
             revision="crDroid-17.0" />

    <remote name="mindthegapps" fetch="https://gitlab.com/MindTheGapps" />
    <project path="vendor/gapps"
             name="vendor_gapps"
             remote="mindthegapps"
             revision="cinnamonbun"
             clone-depth="1" />
</manifest>
